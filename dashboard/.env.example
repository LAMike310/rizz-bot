# Absolute path to the bot's existing SQLite file. The dashboard does not create a database.
WHATSAPP_DB_PATH=/absolute/path/to/rizz-bot/data/whatsapp.db

# Desktop hover-to-send stays off until every value below is set on both processes.
# DASHBOARD_SEND_ENABLED=false
# DASHBOARD_OWNER_SECRET=replace-with-at-least-16-characters
# DASHBOARD_SESSION_SECRET=replace-with-a-different-16-plus-secret
# DASHBOARD_AGENT_TOKEN=same-value-as-the-agent-process
# DASHBOARD_AGENT_PORT=39217
